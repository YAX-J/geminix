# Docker Compose 环境变量（不要提交真实密码到 git）
# 复制为 .env 后填入真实值，docker-compose 自动加载

# ----- 后端数据库 -----
DB_USERNAME=worklog
DB_PASSWORD=worklog_pwd_change_me

# ----- 宿主机 Redis -----
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT 强密钥（≥32 字节随机串，可用 openssl rand -base64 48 生成） -----
JWT_SECRET=please_change_me_to_a_random_32_plus_chars_secret
JWT_EXPIRE_HOURS=24

# ----- 端口映射（按需改） -----
BACKEND_PORT=8089
FRONTEND_PORT=80
